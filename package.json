{
  "name": "bodymechanic-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "sync": "node scripts/sync-assets.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "serve": "next start",
    "i18n": "node scripts/check-i18n.mjs",
    "gate": "node scripts/check-i18n.mjs && npm run test:catalog && npm run test:home-services && npm run test:home-team && npm run test:service-details && npm run test:service-staff && playwright test",
    "test:catalog": "node scripts/check-catalog.mjs",
    "test:home-services": "node scripts/check-home-services.mjs",
    "test:home-team": "node scripts/check-home-team.mjs",
    "test:team-list": "node scripts/check-team-list.mjs",
    "test:service-details": "node scripts/check-service-details.mjs",
    "test:services-list": "node scripts/check-services-list.mjs",
    "test:prices": "node scripts/check-prices.mjs",
    "test:lp-catalog": "node scripts/check-lp-catalog.mjs",
    "test:lp-booking": "node scripts/check-lp-booking.mjs",
    "test:service-staff": "node scripts/check-service-staff.mjs",
    "test:staff-profile": "node scripts/check-staff-profile.mjs",
    "test:booking-services": "node scripts/check-booking-services.mjs",
    "test:booking-service-sets": "node scripts/check-booking-service-sets.mjs",
    "test:booking-review": "node scripts/check-booking-review.mjs",
    "test:booking-availability": "node scripts/check-booking-availability.mjs",
    "test:booking-record": "node scripts/check-booking-record.mjs",
    "test:quick-form": "node scripts/check-quick-form.mjs",
    "test:quick-form-submit": "node scripts/check-quick-form-submit.mjs",
    "test:server": "node scripts/check-server.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:matrix": "node scripts/test-matrix.mjs",
    "gate:clean": "node scripts/clean-build.mjs"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.3",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "gsap": "^3.15.1",
    "libphonenumber-js": "^1.13.16",
    "next": "16.4.5",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.187.0",
    "three-mesh-bvh": "^0.9.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
